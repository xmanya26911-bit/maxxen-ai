# REQUIRED — copy to .env.local (never commit)
# Gmail SMTP sender for OTP (Google App Password, spaces optional)
GMAIL_EMAIL=xmanya26911@gmail.com
GMAIL_APP_PASSWORD=__PUT_YOUR_16CHAR_APP_PASSWORD_HERE__

# Optional: dedicated HMAC secret for OTP tickets + sessions.
# If unset, the Gmail app password is used (already a server-side secret).
OTP_SECRET=

# Composio (for plugins). User can also paste key in UI.
COMPOSIO_API_KEY=

# GitHub / Vercel are BYOT — users paste their own tokens in UI.
# No server-side GitHub/Vercel secrets required for MVP.