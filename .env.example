# MAXXEN environment variables
# GitHub, Vercel, Composio and AI provider credentials are stored locally
# and/or in the user's encrypted maxxen-data vault.

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional in production when the public host differs from the request origin.
MAXXEN_APP_URL=https://maxxen.vercel.app
# Google login (GIS): public client id for the button + server audience check.
# Get one at https://console.cloud.google.com/apis/credentials (OAuth client,
# type "Web application"); add the same value to NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Server secrets for Gmail OTP + session signing. OTP_SECRET signs sessions
# and OTP tickets (falls back to GMAIL_APP_PASSWORD, then a dev-only value
# outside production). Gmail sending needs GMAIL_EMAIL + GMAIL_APP_PASSWORD.
OTP_SECRET=
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
# Optional: operator-hosted SearXNG for web search (server-side only).
SEARXNG_BASE_URL=
