:81 {
	# Security: do NOT re-add query-driven reverse_proxy targets (e.g. an
	# XTransformPort matcher). They turn this edge into an open proxy to any
	# localhost port. Only fixed upstreams belong here.
	handle {
		reverse_proxy localhost:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}
}
